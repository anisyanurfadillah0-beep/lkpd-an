rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isValidRole(role) {
      return role in ['student', 'teacher', 'admin'];
    }

    function isTeacherOrAdmin() {
      return isSignedIn() && roleOf(request.auth.uid) in ['teacher', 'admin'];
    }

    match /users/{uid} {
      allow get: if isSignedIn() && (
        request.auth.uid == uid ||
        roleOf(request.auth.uid) == 'admin'
      );

      allow list: if isSignedIn() && roleOf(request.auth.uid) == 'admin';

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.role == 'student'
        && request.resource.data.classIds is list
        && request.resource.data.createdAt is timestamp;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.name is string;

      allow delete: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && roleOf(request.auth.uid) == 'teacher';
      allow update: if isSignedIn() && (
        roleOf(request.auth.uid) == 'admin' ||
        roleOf(request.auth.uid) == 'teacher'
      );
      allow delete: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
    }

    match /classMembers/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.role == 'student';
      allow update: if isSignedIn() && request.auth.uid == resource.data.studentUid;
      allow delete: if isSignedIn() && roleOf(request.auth.uid) == 'teacher';
    }

    match /teacherInvitations/{invitationId} {
      allow read: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
      allow create: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
      allow update: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
      allow delete: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
    }

    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        roleOf(request.auth.uid) == 'teacher' ||
        roleOf(request.auth.uid) == 'admin'
      );

      allow create: if isSignedIn()
        && roleOf(request.auth.uid) == 'student'
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.role == 'student';

      allow update: if isTeacherOrAdmin();

      allow delete: if isTeacherOrAdmin();
    }

    match /appData/{documentId} {
      allow read: if isSignedIn() && isValidRole(roleOf(request.auth.uid));
      allow write: if isSignedIn()
        && roleOf(request.auth.uid) in ['teacher', 'admin'];
    }

    match /{document=**} {
      allow read: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
      allow write: if false;
    }
  }
}
