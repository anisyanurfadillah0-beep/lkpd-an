rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isValidRole(role) {
      return role in ['student', 'teacher', 'admin'];
    }

    function isTeacherOrAdmin() {
      return isSignedIn() && roleOf(request.auth.uid) in ['teacher', 'admin'];
    }

    function hasClassMembership(classId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/classMemberships/$(string(classId)));
    }

    function classAccessCodeMatches(classId, accessCode) {
      return exists(/databases/$(database)/documents/classAccessCodes/$(string(classId)))
        && get(/databases/$(database)/documents/classAccessCodes/$(string(classId))).data.accessCode == accessCode;
    }

    function validRubricQuestion(data, key) {
      return !(key in data.keys()) || (
        data[key] is map
        && data[key].keys().hasAll(['maxPoin', 'kunci', 'rubrikTeks'])
        && data[key].maxPoin is int
        && data[key].kunci is string
        && data[key].rubrikTeks is string
      );
    }

    function validRubricQuestions(data) {
      return validRubricQuestion(data, 'q1')
        && validRubricQuestion(data, 'q2')
        && validRubricQuestion(data, 'q3')
        && validRubricQuestion(data, 'q4')
        && validRubricQuestion(data, 'q5')
        && validRubricQuestion(data, 'q6')
        && validRubricQuestion(data, 'q7')
        && validRubricQuestion(data, 'q8')
        && validRubricQuestion(data, 'q9')
        && validRubricQuestion(data, 'q10')
        && validRubricQuestion(data, 'q11')
        && validRubricQuestion(data, 'q12')
        && validRubricQuestion(data, 'q13')
        && validRubricQuestion(data, 'q14')
        && validRubricQuestion(data, 'q15')
        && validRubricQuestion(data, 'q16')
        && validRubricQuestion(data, 'q17')
        && validRubricQuestion(data, 'q18')
        && validRubricQuestion(data, 'q19')
        && validRubricQuestion(data, 'q20');
    }

    function validPrivateDocument(data, docId) {
      return data.taskId is string
        && data.taskId == docId
        && data.title is string
        && data.totalPoin is int
        && data.totalPoin > 0
        && data.createdBy is string
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if isSignedIn() && (
        request.auth.uid == uid ||
        roleOf(request.auth.uid) == 'admin'
      );

      allow list: if isSignedIn() && roleOf(request.auth.uid) == 'admin';

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.role == 'student'
        && request.resource.data.classIds is list
        && request.resource.data.createdAt is timestamp;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.name is string
        && (
          request.resource.data.get('classId', null) == resource.data.get('classId', null)
          || (
            request.resource.data.get('classId', null) is int
            && hasClassMembership(request.resource.data.classId)
          )
        );

      allow delete: if isSignedIn() && roleOf(request.auth.uid) == 'admin';

      match /classMemberships/{classId} {
        allow get: if isSignedIn() && (
          request.auth.uid == uid || isTeacherOrAdmin()
        );
        allow list: if isTeacherOrAdmin();
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.studentUid == uid
          && request.resource.data.classId is int
          && string(request.resource.data.classId) == classId
          && request.resource.data.accessCode is string
          && classAccessCodeMatches(classId, request.resource.data.accessCode);
        allow update: if isTeacherOrAdmin() || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.classId == resource.data.classId
        );
        allow delete: if isTeacherOrAdmin();
      }
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && roleOf(request.auth.uid) == 'teacher';
      allow update: if isSignedIn() && (
        roleOf(request.auth.uid) == 'admin' ||
        roleOf(request.auth.uid) == 'teacher'
      );
      allow delete: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
    }

    match /classMembers/{memberId} {
      allow get: if isSignedIn() && (
        isTeacherOrAdmin() || resource.data.studentUid == request.auth.uid
      );
      allow list: if isTeacherOrAdmin();
      allow create: if isSignedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.role == 'student'
        && request.resource.data.classId is int
        && request.resource.data.accessCode is string
        && classAccessCodeMatches(request.resource.data.classId, request.resource.data.accessCode);
      allow update: if isTeacherOrAdmin() || (
        isSignedIn()
        && request.auth.uid == resource.data.studentUid
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.classId == resource.data.classId
      );
      allow delete: if isTeacherOrAdmin();
    }

    match /classAccessCodes/{classId} {
      allow read, write: if isTeacherOrAdmin();
    }

    match /teacherInvitations/{invitationId} {
      allow read: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
      allow create: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
      allow update: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
      allow delete: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
    }

    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        roleOf(request.auth.uid) == 'teacher' ||
        roleOf(request.auth.uid) == 'admin'
      );

      allow create: if isSignedIn()
        && roleOf(request.auth.uid) == 'student'
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.role == 'student'
        && !request.resource.data.keys().hasAny([
          'status', 'aiScore', 'aiReview', 'finalScore', 'nilai', 'nilaiAi',
          'teacherNote', 'feedback', 'questionReviews'
        ]);

      allow update: if isTeacherOrAdmin();

      allow delete: if isTeacherOrAdmin();
    }

    match /gradingRubrics/{docId} {
      allow read: if isSignedIn()
        && roleOf(request.auth.uid) in ['teacher', 'admin'];
      allow create, update: if isTeacherOrAdmin()
        && validPrivateDocument(request.resource.data, docId)
        && validRubricQuestions(request.resource.data);
      allow delete: if isTeacherOrAdmin();
    }

    match /gradingSuggestions/{submissionId} {
      allow read, write: if isTeacherOrAdmin();
    }

    match /answerKeys/{docId} {
      allow read: if isSignedIn()
        && roleOf(request.auth.uid) in ['teacher', 'admin'];
      allow create, update: if isTeacherOrAdmin()
        && validPrivateDocument(request.resource.data, docId)
        && request.resource.data.answers is list;
      allow delete: if isTeacherOrAdmin();
    }

    match /appData/{documentId} {
      allow read: if isSignedIn() && isValidRole(roleOf(request.auth.uid));
      allow write: if isSignedIn()
        && roleOf(request.auth.uid) in ['teacher', 'admin'];
    }

    match /{document=**} {
      allow read: if isSignedIn() && roleOf(request.auth.uid) == 'admin';
      allow write: if false;
    }
  }
}
